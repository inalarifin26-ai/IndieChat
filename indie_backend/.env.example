PORT=4000
JWT_SECRET=change-this-to-a-long-random-string

# Optional: enables real AI replies in agent chats (falls back to scripted
# replies when unset). Get a key at https://console.anthropic.com/
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
DB_PATH=./data/indie.db

# Optional: enables the Google connectors (Calendar, Gmail, Drive — OAuth).
# Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth client ID, type "Web application"). PUBLIC_BASE_URL is this
# server's own externally-reachable URL; each connector derives its own
# callback path from it (e.g. {PUBLIC_BASE_URL}/connectors/gmail/callback) —
# register ALL of those exact URLs as authorized redirect URIs for the
# client (one per connector: google_calendar, gmail, google_drive). Without
# these three set, every connector's /authorize returns a clear "not
# configured" error (501) — nothing else is affected.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# PUBLIC_BASE_URL=http://localhost:4000

# Optional: key used to encrypt connector tokens at rest (AES-256-GCM). A
# clearly-labeled insecure default is used if unset — fine for local dev,
# NOT for anything real.
# CONNECTOR_ENC_KEY=

# Optional hardening knobs (defaults shown). Behind a reverse proxy set TRUST_PROXY so rate limits
# see the real client IP; set CORS_ORIGINS to restrict browser origins (native apps are unaffected).
# TRUST_PROXY=1
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
# RL_LOGIN_MAX=8        # failed log-ins per 15 min, per client + account
# RL_RECOVER_MAX=5      # failed recoveries per 15 min, per client + account
# RL_REGISTER_MAX=30    # new accounts per hour, per client
# RL_LOOKUP_MAX=60      # Indie-ID availability/suggestion lookups per minute, per client
