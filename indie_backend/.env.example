PORT=4000
JWT_SECRET=change-this-to-a-long-random-string

# Optional: enables real AI replies in agent chats (falls back to scripted
# replies when unset). Get a key at https://console.anthropic.com/
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
DB_PATH=./data/indie.db

# Optional: enables the Google Calendar connector (OAuth). Create credentials
# at https://console.cloud.google.com/apis/credentials (OAuth client ID,
# type "Web application"), add GOOGLE_REDIRECT_URI as an authorized redirect
# URI there. Without these, /connectors/google_calendar/authorize returns a
# clear "not configured" error (501) — nothing else is affected.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:4000/connectors/google_calendar/callback

# Optional: key used to encrypt connector tokens at rest (AES-256-GCM). A
# clearly-labeled insecure default is used if unset — fine for local dev,
# NOT for anything real.
# CONNECTOR_ENC_KEY=
